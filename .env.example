APP_NAME="Carolina Transient & Airbnb"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app-domain.example

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=your-mysql-host
DB_PORT=3306
DB_DATABASE=carolina5
DB_USERNAME=your-mysql-user
DB_PASSWORD=your-strong-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ADMIN_ADDRESS=

# Production example (Resend SMTP): set these only in Render's Environment page.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_USERNAME=resend
# MAIL_PASSWORD=your-resend-api-key
# MAIL_FROM_ADDRESS=bookings@your-verified-domain.com

# Optional one-time acceptance-testing accounts. Set these only in host settings,
# seed once, then clear the passwords and turn RUN_INITIAL_SEED off.
TEST_STAFF_EMAIL=
TEST_STAFF_PASSWORD=
TEST_STAFF_ROLE=front_desk
TEST_HOUSEKEEPING_EMAIL=
TEST_HOUSEKEEPING_PASSWORD=
TEST_VIEWER_EMAIL=
TEST_VIEWER_PASSWORD=

# Reservation deposits are manually verified in the GCash Business wallet.
BOOKING_DEPOSIT_PERCENTAGE=30
BOOKING_MINIMUM_DEPOSIT=500
GCASH_RECIPIENT_NAME="Carolina GCash Business"
GCASH_NUMBER=
GCASH_QR_URL=
